{
  "name": "@typix-editor/react",
  "version": "4.1.0",
  "description": "React adapter for Typix editor framework",
  "author": "Diyorbek Juraev <mrdiyorbekjuraev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrdiyorbek-juraev/typix.git"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup",
    "dev": "pnpm build:fast --watch",
    "clean": "rm -rf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@typix-editor/utils": "workspace:*",
    "@lexical/react": "^0.40.0",
    "@lexical/extension": "^0.40.0",
    "@lexical/text": "^0.40.0",
    "@lexical/utils": "^0.40.0"
  },
  "peerDependencies": {
    "@typix-editor/core": "workspace:*",
    "react": "^18.2.0 || ^19.0.0-0",
    "react-dom": "^18.2.0 || ^19.0.0-0"
  },
  "devDependencies": {
    "@typix-editor/core": "workspace:*",
    "lexical": "^0.40.0",
    "@lexical/headless": "^0.40.0",
    "@lexical/mark": "^0.40.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.1",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": ["typix", "editor", "rich-text", "react", "lexical", "wysiwyg"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://typix.com",
  "bugs": {
    "url": "https://github.com/mrdiyorbek-juraev/typix/issues"
  }
}
