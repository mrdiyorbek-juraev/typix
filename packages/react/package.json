{
  "name": "@typix-editor/react",
  "version": "5.0.0",
  "description": "React adapter for Typix editor framework",
  "author": "Diyorbek Juraev <mrdiyorbekjuraev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrdiyorbek-juraev/typix.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup",
    "dev": "pnpm build:fast --watch",
    "clean": "rm -rf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@typix-editor/utils": "workspace:*",
    "@lexical/react": "catalog:",
    "@lexical/extension": "catalog:",
    "@lexical/text": "catalog:",
    "@lexical/utils": "catalog:"
  },
  "peerDependencies": {
    "@typix-editor/core": "workspace:*",
    "lexical": "catalog:",
    "react": "^18.2.0 || ^19.0.0-0",
    "react-dom": "^18.2.0 || ^19.0.0-0"
  },
  "devDependencies": {
    "@typix-editor/core": "workspace:*",
    "lexical": "catalog:",
    "@lexical/headless": "catalog:",
    "@lexical/mark": "catalog:",
    "@types/node": "^24.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "typix",
    "editor",
    "rich-text",
    "react",
    "lexical",
    "wysiwyg"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://typix.com",
  "bugs": {
    "url": "https://github.com/mrdiyorbek-juraev/typix/issues"
  }
}
