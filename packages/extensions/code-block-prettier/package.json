{
  "name": "@typix-editor/extension-code-block-prettier",
  "version": "4.1.0",
  "description": "Prettier code formatter extension for Typix code blocks",
  "keywords": [
    "typix",
    "editor",
    "lexical",
    "prettier",
    "code-block",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Diyorbek Juraev <mrdiyorbekjuraev@gmail.com>",
  "homepage": "https://typix.com",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdiyorbek-juraev/typix.git"
  },
  "bugs": {
    "url": "https://github.com/mrdiyorbek-juraev/typix/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup",
    "dev": "pnpm build:fast --watch",
    "clean": "rm -rf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "peerDependencies": {
    "@typix-editor/core": "^4.1.0",
    "prettier": ">=3"
  },
  "devDependencies": {
    "@typix-editor/core": "workspace:*",
    "@types/node": "^25.1.0",
    "lexical": "^0.40.0",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
