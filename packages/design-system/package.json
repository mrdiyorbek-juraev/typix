{
  "name": "@typix-editor/ui",
  "version": "2.0.0",
  "private": true,
  "description": "Typix design system — shadcn primitives + editor components (CLI template, not published to npm)",
  "author": "Diyorbek Juraev <mrdiyorbekjuraev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./src/styles/index.css",
    "./styles/tokens": "./src/styles/tokens.css",
    "./styles/editor": "./src/styles/editor.css",
    "./styles/tailwind": "./src/styles/tailwind.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-toolbar": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.563.0",
    "react-day-picker": "^9.5.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "@typix-editor/core": "workspace:*",
    "@typix-editor/extension-code-block": "workspace:*",
    "@typix-editor/extension-code-block-prettier": "workspace:*",
    "@typix-editor/extension-floating-link": "workspace:*",
    "@typix-editor/extension-mention": "workspace:*",
    "@typix-editor/extension-speech-to-text": "workspace:*",
    "@typix-editor/extension-starter-kit": "workspace:*",
    "@typix-editor/extension-table": "workspace:*",
    "@typix-editor/react": "workspace:*",
    "@typix-editor/utils": "workspace:*",
    "react": "^18.2.0 || ^19.0.0-0",
    "react-dom": "^18.2.0 || ^19.0.0-0"
  },
  "peerDependenciesMeta": {
    "@typix-editor/core": {
      "optional": true
    },
    "@typix-editor/extension-floating-link": {
      "optional": true
    },
    "@typix-editor/extension-link": {
      "optional": true
    },
    "@typix-editor/extension-mention": {
      "optional": true
    },
    "@typix-editor/extension-speech-to-text": {
      "optional": true
    },
    "@typix-editor/extension-code-block": {
      "optional": true
    },
    "@typix-editor/extension-code-block-prettier": {
      "optional": true
    },
    "@typix-editor/extension-starter-kit": {
      "optional": true
    },
    "@typix-editor/extension-table": {
      "optional": true
    },
    "@typix-editor/react": {
      "optional": true
    },
    "@typix-editor/utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typix-editor/core": "workspace:*",
    "@typix-editor/extension-code-block": "workspace:*",
    "@typix-editor/extension-code-block-prettier": "workspace:*",
    "@typix-editor/extension-floating-link": "workspace:*",
    "@typix-editor/extension-mention": "workspace:*",
    "@typix-editor/extension-speech-to-text": "workspace:*",
    "@typix-editor/extension-starter-kit": "workspace:*",
    "@typix-editor/extension-table": "workspace:*",
    "@typix-editor/extension-link": "workspace:*",
    "@typix-editor/react": "workspace:*",
    "@typix-editor/utils": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@tailwindcss/cli": "^4.1.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
