{
  "name": "@typix-editor/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Typix design system — shadcn primitives + editor components (CLI template, not published to npm)",
  "author": "Diyorbek Juraev <mrdiyorbekjuraev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o dist/index.css --minify",
    "build:fast": "tsup",
    "dev": "concurrently \"tsup --watch\" \"tailwindcss -i src/styles/tailwind.css -o dist/index.css --watch\"",
    "clean": "rm -rf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-toolbar": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.563.0",
    "react-day-picker": "^9.5.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "@lexical/link": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@typix-editor/core": "workspace:*",
    "@typix-editor/extension-floating-link": "workspace:*",
    "@typix-editor/extension-mention": "workspace:*",
    "@typix-editor/extension-speech-to-text": "workspace:*",
    "@typix-editor/react": "workspace:*",
    "lexical": "^0.40.0",
    "react": "^18.2.0 || ^19.0.0-0",
    "react-dom": "^18.2.0 || ^19.0.0-0"
  },
  "peerDependenciesMeta": {
    "@lexical/link": {
      "optional": true
    },
    "@lexical/react": {
      "optional": true
    },
    "@lexical/utils": {
      "optional": true
    },
    "@typix-editor/core": {
      "optional": true
    },
    "@typix-editor/extension-floating-link": {
      "optional": true
    },
    "@typix-editor/extension-mention": {
      "optional": true
    },
    "@typix-editor/extension-speech-to-text": {
      "optional": true
    },
    "@typix-editor/react": {
      "optional": true
    },
    "lexical": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lexical/link": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@typix-editor/core": "workspace:*",
    "@typix-editor/extension-floating-link": "workspace:*",
    "@typix-editor/extension-mention": "workspace:*",
    "@typix-editor/extension-speech-to-text": "workspace:*",
    "@typix-editor/react": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.1",
    "@tailwindcss/cli": "^4.1.4",
    "concurrently": "^9.1.2",
    "lexical": "^0.40.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
