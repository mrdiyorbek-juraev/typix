{
  "name": "@typix-editor/theme",
  "version": "4.1.0",
  "description": "Framework-agnostic design tokens and styles for Typix editor",
  "author": "Diyorbek Juraev <mrdiyorbekjuraev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/typix.css",
  "style": "dist/typix.css",
  "exports": {
    ".": "./dist/typix.css",
    "./css": "./dist/typix.css",
    "./css/min": "./dist/typix.min.css",
    "./scss": "./scss/typix.scss",
    "./scss/*": "./scss/*"
  },
  "files": [
    "dist",
    "scss"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "sass scss/typix.scss dist/typix.css --no-source-map && sass scss/typix.scss dist/typix.min.css --style=compressed --no-source-map",
    "build:fast": "sass scss/typix.scss dist/typix.css --no-source-map",
    "dev": "sass scss/typix.scss dist/typix.css --watch --no-source-map",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "devDependencies": {
    "sass": "^1.86.0"
  },
  "keywords": [
    "typix",
    "editor",
    "theme",
    "design-tokens",
    "css",
    "scss"
  ],
  "publishConfig": {
    "access": "public"
  }
}
